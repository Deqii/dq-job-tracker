{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["design/DESIGN.md"],
  "permission": {
    "edit": {
      "*": "allow",
      "design/design.css": "deny",
      "design/tokens.json": "deny",
      "design/motion-table.md": "deny",
      "design/extract-report.txt": "deny",
      "design/mockups/*": "deny",
      "design/tools/*": "deny"
    },
    "bash": {
      "*": "allow",
      "node design/tools/extract.mjs*": "ask",
      "npm run design:sync*": "ask"
    }
  }
}
