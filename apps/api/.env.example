# MySQL connection string used by Prisma
# XAMPP default (no password): mysql://root@localhost:3306/job_tracker
DATABASE_URL=mysql://root:password@localhost:3306/job_tracker

# Signing secret for auth tokens (use a long random string in production)
JWT_SECRET=change-me-in-production

# Port the API listens on
PORT=4000

# Node environment (development | production)
NODE_ENV=development
