  "outDir": "design/.verify",
  "pixel": { "threshold": 0.1, "maxDiffRatio": 0.005, "tileSize": 64, "maxTileRatio": 0.02 },
  "audit": { "ignoreSelectors": [], "extraAllowedColors": [] },
